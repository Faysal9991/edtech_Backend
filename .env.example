APP_ENV=development
APP_NAME=lms-backend
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=15s
DATABASE_URL=postgres://lms:lms@postgres:5432/lms?sslmode=disable
DB_MAX_CONNS=20
DB_MIN_CONNS=2
DB_QUERY_TIMEOUT=5s
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=lms-private
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me
S3_FORCE_PATH_STYLE=true
FIREBASE_PROJECT_ID=your-firebase-project
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-credentials.json
FAKE_AUTH_ENABLED=true
DEVICE_TOKEN_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
LIVEKIT_URL=wss://your-livekit.example.com
LIVEKIT_API_KEY=replace-me
LIVEKIT_API_SECRET=replace-me
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
PUBLIC_API_URL=http://localhost:8080
CERTIFICATE_VERIFY_BASE_URL=http://localhost:8080/api/v1/public/certificates/verify
UPLOAD_MAX_VIDEO_BYTES=2147483648
UPLOAD_MAX_PDF_BYTES=52428800
UPLOAD_MAX_IMAGE_BYTES=10485760
SIGNED_URL_TTL=15m
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW=1m
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
OTEL_EXPORTER_OTLP_ENDPOINT=
