# Runtime: development, test, or production.
APP_ENV=development
APP_NAME=lms-service
DEFAULT_ORGANIZATION_SLUG=lms

# HTTP listener, timeouts, explicit browser origins, and public URLs.
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=15s
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
PUBLIC_API_URL=http://localhost:8080
CERTIFICATE_VERIFY_BASE_URL=http://localhost:8080/api/v1/certificates/verify

# PostgreSQL DSN and pgx pool limits.
DATABASE_URL=postgres://lms:replace-local-password@localhost:5432/lms?sslmode=disable
DB_MAX_CONNS=20
DB_MIN_CONNS=2
DB_QUERY_TIMEOUT=5s

# Redis URL is preferred; REDIS_ADDR/PASSWORD/DB remain supported.
REDIS_URL=redis://localhost:6379/0
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT HMAC key must be a random value of at least 32 characters. Never reuse
# the example placeholder. Key IDs allow a future verification key ring.
JWT_ISSUER=lms-service
JWT_AUDIENCE=lms-clients
JWT_KEY_ID=v1
JWT_SIGNING_KEY=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL=720h
EMAIL_VERIFICATION_TTL=24h
PASSWORD_RESET_TTL=30m

# Argon2id PHC parameters (memory is KiB).
ARGON2_MEMORY_KIB=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=2
ARGON2_SALT_BYTES=16
ARGON2_KEY_BYTES=32

# Private S3-compatible object storage. Use MinIO values only for local work.
S3_ENDPOINT=http://localhost:9000
# Optional client-visible endpoint when the service reaches storage through an
# internal Docker/DNS name.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=lms-private
S3_ACCESS_KEY=replace-local-access-key
S3_SECRET_KEY=replace-local-secret-key
S3_FORCE_PATH_STYLE=true
SIGNED_URL_TTL=15m
UPLOAD_MAX_VIDEO_BYTES=2147483648
UPLOAD_MAX_PDF_BYTES=52428800
UPLOAD_MAX_IMAGE_BYTES=10485760

# mock is allowed only outside production; Stripe values are required when
# PAYMENT_PROVIDER=stripe.
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=replace-local-webhook-secret

# LiveKit credentials are required in production. Local tests inject a fake.
LIVEKIT_URL=wss://replace-livekit-host
LIVEKIT_API_KEY=replace-livekit-api-key
LIVEKIT_API_SECRET=replace-livekit-api-secret

# log is the local notification adapter. FCM uses Application Default
# Credentials or GOOGLE_APPLICATION_CREDENTIALS outside this repository.
NOTIFICATION_PROVIDER=log
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
DEVICE_TOKEN_ENCRYPTION_KEY=replace-with-at-least-32-random-characters

RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW=1m
WORKER_CONCURRENCY=10
LOG_LEVEL=debug
OTEL_EXPORTER_OTLP_ENDPOINT=

# Development/test seed only. The commands read these values and never print
# passwords. Use unique values even for local work.
SEED_ORGANIZATION_NAME=LMS Development
SEED_ADMIN_EMAIL=admin@lms.local
SEED_ADMIN_DISPLAY_NAME=Development Administrator
SEED_ADMIN_PASSWORD=replace-with-a-strong-local-password
SEED_DEMO_PASSWORD=replace-with-a-strong-demo-password
